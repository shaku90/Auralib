{
  "name": "auralib",
  "private": true,
  "version": "1.2.1",
  "description": "Sistema de Gestión Bibliotecaria",
  "homepage": "https://github.com/shaku90/Auralib",
  "license": "GPL-3.0",
  "author": {
    "name": "Facundo Belascoain Kirby",
    "email": "facundo.belascoain@gmail.com"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npx esbuild electron/main.ts --bundle --platform=node --format=esm --outfile=dist-electron/main.js --external:electron && npx esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.js --external:electron",
    "build:app": "npm run build && electron-builder",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.auralib.app",
    "productName": "Auralib",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "appx"
      ],
      "icon": "assets/icon.ico"
    },
    "appx": {
      "applicationId": "Auralib",
      "identityName": "com.auralib.app",
      "publisherDisplayName": "Facundo Belascoain Kirby"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Education",
      "maintainer": "Facundo Belascoain Kirby <facundo.belascoain@gmail.com>"
    }
  },
  "dependencies": {
    "marcjs": "^3.0.2",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
